# Copy to .env and fill real values, OR (preferred) run with Infisical so no .env exists:
#   infisical run --env dev -- .venv/bin/uvicorn app.main:app --reload
# .env is git-ignored — NEVER commit secrets. Every provider below is a free tier, no card.

# --- App ---
APP_NAME=athenaeum-backend
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Learner workspace (courses / messages / assessments) ---
# SQLite by default (file relative to the backend working directory).
# DATABASE_URL=sqlite:///./athenaeum.db
# Force deterministic offline chat replies (no provider calls). CI/E2E set this true.
# OFFLINE_LLM=false
# Athenaeum course catalog path; defaults to ../../athenaeum/content/_catalog.json
# ATHENAEUM_CATALOG_PATH=

# --- Assessment question banks (SEPARATE DB from the learner workspace) ---
# Seeded at startup from the in-repo JSON banks.
# ASSESSMENTS_DATABASE_URL=sqlite:///./assessments.db
# SEED_ASSESSMENTS_ON_STARTUP=true

# --- LLMs: Groq (tiers 1-2) → Gemini (tiers 3-4) fallback chain ---
# https://console.groq.com/keys  (free, no card)
GROQ_API_KEY=<your-groq-key>
# GROQ_MODEL_WORKHORSE=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_REASONING=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low
# GROQ_MODEL_GUARD=meta-llama/llama-prompt-guard-2-86m   # injection/jailbreak classifier
# GUARD_BLOCK_THRESHOLD=0.8
# https://aistudio.google.com/apikey  (free tier, no billing)
GEMINI_API_KEY=<your-gemini-key>
# GEMINI_MODEL_WORKHORSE=gemini-2.5-flash
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# --- Live grounding: Cohere embeddings + Qdrant Cloud vector search ---
# https://dashboard.cohere.com/api-keys  (trial key: 1,000 calls/month; queries are cached)
COHERE_API_KEY=<your-cohere-key>
# COHERE_EMBED_MODEL=embed-v4.0
# EMBED_DIMENSIONS=1024
# https://cloud.qdrant.io  (free 1 GB cluster; suspended after 1 week idle → keep-alive ping)
QDRANT_URL=<https://your-cluster.cloud.qdrant.io>
QDRANT_API_KEY=<your-qdrant-key>
# QDRANT_COLLECTION=athenaeum-courses
# VECTOR_SEARCH_LIVE=true
